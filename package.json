{
  "name": "git-hist-view",
  "private": true,
  "description": "Animated treemaps, co-change coupling and dependency graphs across a git repository's history, computed in the browser.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "wasm": "bun scripts/build-wasm.mjs",
    "wasm:dev": "bun scripts/build-wasm.mjs --dev",
    "dev": "vite web",
    "build": "bun run wasm && tsc -p web && vite build web",
    "proxy": "wrangler dev -c proxy/wrangler.jsonc --port 8787",
    "deploy": "bun run build && wrangler deploy -c proxy/wrangler.jsonc",
    "check": "tsc -p web && tsc -p proxy",
    "test:e2e": "playwright test",
    "screenshots": "bun scripts/screenshots.mjs",
    "lint": "biome check && cargo fmt --check && cargo clippy --workspace --all-targets -- -D warnings",
    "format": "biome check --write && cargo fmt"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "d3-color": "^3.1.0",
    "d3-interpolate": "^3.0.1",
    "d3-selection": "^3.0.0",
    "d3-time": "^3.1.0",
    "d3-zoom": "^3.0.0",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.14",
    "@cloudflare/workers-types": "^5.20260923.1",
    "@playwright/test": "^1.63.0",
    "@types/d3-color": "^3.1.3",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-time": "^3.0.4",
    "@types/d3-zoom": "^3.0.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-solid": "^2.11.14",
    "wrangler": "^4.137.0"
  }
}
