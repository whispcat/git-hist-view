{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["web/src/**", "web/*.ts", "proxy/src/**", "e2e/**", "scripts/**", "*.ts", "!web/src/wasm"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 160 },
  "javascript": { "formatter": { "quoteStyle": "single", "jsxQuoteStyle": "double", "trailingCommas": "all" } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      // Solid refs (`let el!: HTMLElement`) and accessors read after a guard are idiomatic non-null assertions.
      "style": { "noNonNullAssertion": "off" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
